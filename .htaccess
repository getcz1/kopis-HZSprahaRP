# ===================================================================
#  CAD – zabezpečení (Apache / LiteSpeed)
#  Nahrajte do stejné složky jako index.html a api.php.
#
#  POKUD SE PO NAHRÁNÍ ZOBRAZÍ CHYBA 500 (Internal Server Error):
#  váš hosting nepovoluje některou sekci. Mažte sekce odzdola
#  (nejdřív 4, pak 3, pak 2) a po každém smazání web vyzkoušejte.
#  Sekce 1 je nejdůležitější – tu nechte jako poslední.
#  Nastavení v cad.env.php je chráněné i úplně bez tohoto souboru.
# ===================================================================

# --- 1) Zákaz stažení tajných a systémových souborů (NEJDŮLEŽITĚJŠÍ) ---
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)(^\.|\.(env|ini|log|bak|old|sql|sh|md|json|lock|yml|yaml)$|^(cad\.env|cad\.env\.php|server\.js|package\.json)$)">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "(?i)(^\.|\.(env|ini|log|bak|old|sql|sh|md|json|lock|yml|yaml)$|^(cad\.env|cad\.env\.php|server\.js|package\.json)$)">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# --- 2) Zákaz výpisu obsahu složek ---
Options -Indexes

# --- 3) Bezpečnostní hlavičky ---
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# --- 4) Vynucení HTTPS (zapněte, až budete mít certifikát: smažte znaky # na 3 řádcích) ---
#<IfModule mod_rewrite.c>
#  RewriteEngine On
#  RewriteCond %{HTTPS} off
#  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
#</IfModule>
